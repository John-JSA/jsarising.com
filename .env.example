# Get your free API key from https://resend.com (takes 2 minutes to sign up)
RESEND_API_KEY=your_resend_api_key_here

# Email address where contact/booking form submissions will be sent
CONTACT_TO_EMAIL=info@jsarising.com

# Optional: set your own From address after verifying your domain on Resend
RESEND_FROM_EMAIL=JSA Rising <onboarding@resend.dev>

# Your site URL (used in newsletter welcome email)
NEXT_PUBLIC_SITE_URL=https://www.jsarising.com

# PostgreSQL database URL — get a free one from https://neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
